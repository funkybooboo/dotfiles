#!/usr/bin/env bash
# Check if the TrueNAS SMB share is reachable over Tailscale.
#
# Connectivity moved off the old rsync daemon (port 873 on the now-gone "tnas"
# host) to TrueNAS Scale's SMB service on port 445 at
# truenas.tail54538d.ts.net. The nas-sync-* service units invoke this before
# every run via sync-to-nas; an unreachable share is a skip, not a failure.

NAS_HOST="truenas.tail54538d.ts.net"
NAS_PORT="445"

if timeout 3 bash -c "echo > /dev/tcp/$NAS_HOST/$NAS_PORT" 2>/dev/null; then
    exit 0  # SMB reachable over Tailscale
else
    exit 1  # not reachable (Tailscale down, NAS offline, or SMB service stopped)
fi