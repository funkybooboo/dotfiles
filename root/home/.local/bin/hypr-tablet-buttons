#!/usr/bin/python3
"""hypr-tablet-buttons -- Wacom ExpressKeys as Xournal++ shortcuts.

The shebang is pinned to /usr/bin/python3 (not `env python3`): Arch installs
python-evdev into the system python, while `env python3` may resolve to a
mise python that lacks it -- which would kill this daemon silently (see the
stderr note below).

Hyprland 0.56.2 has no tablet-button binds -- verified against the binary:
the only tablet config keys are output, region_*, active_area_*,
relative_input and left_handed -- so the CTL-4100's four ExpressKeys are
dead without help. This daemon reads ONLY the pad evdev node (matched by
name, so the stylus node is never touched -- that is why keyd was rejected:
stylus and pad share one USB id, and keyd would grab both) and injects
key macros through uinput, the same half of the input path espanso uses
(000325's udev rule grants the input group /dev/uinput; /dev/input/event*
is 0660 root:input).

Button order (top to bottom) still needs one live confirmation: presses log
to stderr, and `uwsm app` does NOT journal daemon stderr (verified live:
only systemd's own Started lines appear), so run
`~/.local/bin/hypr-tablet-buttons` in a terminal to see the reported codes
and fix BUTTONS below if the order is off.

Started by autostart.lua (`uwsm app --`, the espanso pattern) so the
daemon dies with the uwsm scope. See migrations/000586-wacom-tablet.sh.
"""

import json
import re
import subprocess
import sys
import time

try:
    from evdev import InputDevice, UInput, ecodes, list_devices
except ImportError as err:
    print(f"hypr-tablet-buttons: {err} -- run migrations/000586-wacom-tablet.sh", file=sys.stderr)
    sys.exit(1)

# The pad node, by evdev name (hid-wacom names it e.g. "Wacom Intuos S Pad
# pad"). Never touch the stylus/eraser nodes -- see module docstring.
PAD_NAME_RE = re.compile(r"wacom.*\bpad\b", re.IGNORECASE)

# Key macros injected per pad button, expected top-to-bottom. The eraser
# tool in Xournal++ 1.3.8 is Ctrl+Shift+E (verified against
# /usr/share/xournalpp/ui/mainmenubar.xml) -- a bare "e" is bound to nothing.
BUTTONS = {
    ecodes.BTN_0: "undo",
    ecodes.BTN_1: "redo",
    ecodes.BTN_2: "save",
    ecodes.BTN_3: "eraser",
}
COMBOS = {
    "undo":   ([ecodes.KEY_LEFTCTRL], ecodes.KEY_Z),
    "redo":   ([ecodes.KEY_LEFTCTRL, ecodes.KEY_LEFTSHIFT], ecodes.KEY_Z),
    "save":   ([ecodes.KEY_LEFTCTRL], ecodes.KEY_S),
    "eraser": ([ecodes.KEY_LEFTCTRL, ecodes.KEY_LEFTSHIFT], ecodes.KEY_E),
}

# FOCUS GUARD: these macros are Xournal++ shortcuts, and injected keys land
# in whatever window holds focus. Injecting them globally proved destructive:
# pressing an ExpressKey while a terminal had focus sent ctrl+z into it, which
# suspended (and effectively killed) the coding-agent session running there,
# and ctrl+s froze the terminal with XOFF. So: only inject while the focused
# window is Xournal++ itself; every other focus target gets a logged skip.
TARGET_CLASS = "xournalpp"

# Keyboard-only uinput device, with exactly the keys the macros use.
UI_CAPS = {
    ecodes.EV_KEY: sorted(
        {ecodes.KEY_Z, ecodes.KEY_S, ecodes.KEY_E,
         ecodes.KEY_LEFTCTRL, ecodes.KEY_LEFTSHIFT}
    )
}

RESCAN_SECONDS = 2  # tablet absent / driver not yet bound: rescan interval
HOLD_SECONDS = 0.04  # injected press+release hold


def find_pad():
    """The pad evdev node by name; None while the tablet is absent."""
    for path in list_devices():
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if PAD_NAME_RE.search(dev.name):
            return dev
        dev.close()
    return None


def xournal_focused():
    """True only while the focused window is Xournal++ (see FOCUS GUARD)."""
    try:
        out = subprocess.run(
            ["hyprctl", "activewindow", "-j"], capture_output=True, text=True
        ).stdout
        cls = json.loads(out).get("class", "")
    except (OSError, ValueError, subprocess.CalledProcessError):
        return False
    return TARGET_CLASS in cls.lower()


def inject(ui, action):
    """Send one macro: modifiers down, key tap, modifiers up."""
    mods, key = COMBOS[action]
    for m in mods:
        ui.write(ecodes.EV_KEY, m, 1)
    ui.write(ecodes.EV_KEY, key, 1)
    ui.syn()
    time.sleep(HOLD_SECONDS)
    ui.write(ecodes.EV_KEY, key, 0)
    for m in reversed(mods):
        ui.write(ecodes.EV_KEY, m, 0)
    ui.syn()


def main():
    # Fail loudly, not silently: a missing uinput permission looks exactly
    # like a dead daemon otherwise (the espanso trap).
    try:
        ui = UInput(UI_CAPS, name="hypr-tablet-buttons")
    except OSError as err:
        print(f"hypr-tablet-buttons: cannot open /dev/uinput: {err}", file=sys.stderr)
        return 1

    dev = None
    while True:
        if dev is None:
            dev = find_pad()
            if dev is None:
                time.sleep(RESCAN_SECONDS)
                continue
            print(f"hypr-tablet-buttons: pad = {dev.name} ({dev.path})", file=sys.stderr)
        try:
            for event in dev.read_loop():
                if event.type != ecodes.EV_KEY or event.value != 1:
                    continue  # presses only
                action = BUTTONS.get(event.code)
                if action is None:
                    print(f"hypr-tablet-buttons: unmapped button code {event.code}"
                          " -- add to BUTTONS", file=sys.stderr)
                    continue
                if not xournal_focused():
                    print(f"hypr-tablet-buttons: skip {action}"
                          " (focus is not Xournal++)", file=sys.stderr)
                    continue
                print(f"hypr-tablet-buttons: {action} "
                          f"({'+'.join(_name(action))})", file=sys.stderr)
                inject(ui, action)
        except OSError as err:
            # Replug or suspend: the node vanished; rescan.
            print(f"hypr-tablet-buttons: pad gone ({err}), rescanning", file=sys.stderr)
            try:
                dev.close()
            except OSError:
                pass
            dev = None


def _name(action):
    """Human form of a combo for the log line."""
    mods, key = COMBOS[action]
    parts = ["ctrl" if m == ecodes.KEY_LEFTCTRL else "shift" for m in mods]
    parts.append(ecodes.KEY[key].replace("KEY_", "").lower())
    return parts


if __name__ == "__main__":
    sys.exit(main())
