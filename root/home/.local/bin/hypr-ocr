#!/bin/bash

set -euo pipefail

# Cancelling the selection (Escape / right click) exits slurp non-zero. That is a
# decision not to OCR, not a failure, so it must not reach the error notification.
region=$(slurp -b '#cba6f780' -c '#cba6f7' -s '#00000060' -w 2) || exit 0

# Upscaled at capture time: measured a consistent ~1pp accuracy gain over 1x on
# 11-16pt text blocks. 4x is not better, and neither helps icon-heavy strips.
if ! text=$(grim -g "$region" -s 3 - \
    | tesseract - - -l eng --psm 6 2>/dev/null \
    | tr -d '\f'); then
    notify-send "OCR" "Capture or recognition failed" \
        -h string:x-canonical-private-synchronous:ocr
    exit 1
fi

if [[ -z "${text//[[:space:]]/}" ]]; then
    notify-send "OCR" "No text found" \
        -h string:x-canonical-private-synchronous:ocr
    exit 0
fi

# printf, not echo: a trailing newline on a one-line capture submits the form or
# shell prompt it is pasted into.
printf '%s' "$text" | wl-copy

notify-send "OCR" "$(head -c 120 <<< "$text")" \
    -h string:x-canonical-private-synchronous:ocr
