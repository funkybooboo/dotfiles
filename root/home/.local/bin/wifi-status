#!/usr/bin/env bash
# wifi-status -- one-line network state for the quickshell bar.
#
# The fleet's network stack is iwd + systemd-networkd (migrations/000402):
# there is no NetworkManager, and quickshell's Networking singleton speaks only
# NetworkManager (quickshell.network.networkmanager in the binary -- no iwd
# backend), so root/home/.config/quickshell/Network.qml reads state through this
# script instead of Quickshell.Networking.
#
# Output, exactly one line:
#   wifi <dbm> <ssid>   wifi connected; dbm is the iwd RSSI in dBm (negative),
#                       ssid last because it may contain spaces
#   wired               a physical non-wifi interface is up
#   off                 nothing connected (wifi present but disconnected
#                       included -- it reads the same as absent in the bar)

set -u

# iwctl colorizes even when stdout is a pipe (observed: raw ESC sequences), so
# every parse below strips them first.
_strip_ansi() { sed 's/\x1b\[[0-9;]*m//g'; }

# Wired: a physical, non-wifi interface that is up. /sys/class/net/<if>/device
# exists only for real hardware, which excludes lo and tun devices like
# tailscale0; <if>/wireless marks the wifi interface, which iwctl owns below.
for _netif in /sys/class/net/*; do
  _name="${_netif##*/}"
  [[ "$_name" == "lo" ]] && continue
  [[ -d "$_netif/wireless" ]] && continue
  [[ -e "$_netif/device" ]] || continue
  [[ "$(cat "$_netif/operstate" 2>/dev/null)" == "up" ]] || continue
  echo "wired"
  exit 0
done

# Wifi: iwctl device list names the station-mode interface in field 5
# (Name Address Powered Adapter Mode). Interface names are machine-specific
# (wlan0 here, wlp3s0 elsewhere), so the station is discovered, not assumed.
_station="$(iwctl device list 2>/dev/null | _strip_ansi | awk '$5 == "station" { print $1; exit }')"
if [[ -z "$_station" ]]; then
  echo "off"
  exit 0
fi

_info="$(iwctl station "$_station" show 2>/dev/null | _strip_ansi)"
_state="$(sed -n 's/^[[:space:]]*State[[:space:]]*\(.*\)$/\1/p' <<<"$_info" | tr -d '[:space:]')"
if [[ "$_state" != "connected" ]]; then
  echo "off"
  exit 0
fi

# "Connected network" cannot match ConnectedBss: the pattern requires the
# literal space + property name. RSSI is the instantaneous reading; iwd reports
# -32768 or similar sentinels when the link is broken, which the QML clamps.
_ssid="$(sed -n 's/^[[:space:]]*Connected network[[:space:]]\{1,\}\(.*\)$/\1/p' <<<"$_info" | sed 's/[[:space:]]*$//')"
_rssi="$(sed -n 's/^[[:space:]]*RSSI[[:space:]]\{1,\}\(-\{0,1\}[0-9]\{1,\}\).*/\1/p' <<<"$_info")"

echo "wifi ${_rssi:--32768} ${_ssid:-<unknown>}"