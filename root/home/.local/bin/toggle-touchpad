#!/bin/sh
# Toggle libinput touchpad on/off via hyprctl
# State is tracked in a file since getoption input:touchpad:enabled is unavailable
#
# hyprctl lists touchpads under .mice[], not .touchpads[] (empty on tested
# hardware), so DEVICE is resolved by name instead of hardcoded per-host.
DEVICE=$(hyprctl devices -j | jq -r '.mice[] | select(.name | test("touchpad"; "i")) | .name' | head -1)
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/touchpad-enabled"

if [ -z "$DEVICE" ]; then
    echo "toggle-touchpad: no touchpad device found via hyprctl devices" >&2
    exit 1
fi

# Default to enabled if no state file
if [ -f "$STATE_FILE" ] && [ "$(cat "$STATE_FILE")" = "0" ]; then
    hyprctl keyword "device[$DEVICE]:enabled" true
    echo 1 > "$STATE_FILE"
else
    hyprctl keyword "device[$DEVICE]:enabled" false
    echo 0 > "$STATE_FILE"
fi
