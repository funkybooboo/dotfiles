#!/bin/bash
# hypr-keybindings-doc -- regenerate docs/keybindings.md from the live binds.
#
#   hypr-keybindings-doc            rewrite the doc
#   hypr-keybindings-doc --check    exit 1 if the doc is stale (prints the diff)
#
# The descriptions in bindings.conf / bindings.lua are the single source: this
# reads them back out of `hyprctl binds -j` rather than parsing either config, so
# it cannot disagree with what the compositor actually has bound.
#
# That means it REQUIRES a running Hyprland, which also rules out CI -- --check is
# a local drift gate, run it after rebinding.
set -euo pipefail

self="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# <repo>/root/home/.local/bin -> <repo>
repo="$(cd -- "$self/../../../.." && pwd)"
doc="$repo/docs/keybindings.md"

command -v hyprctl >/dev/null || { echo "hyprctl not found" >&2; exit 1; }
hyprctl binds -j >/dev/null 2>&1 || { echo "no running Hyprland to read binds from" >&2; exit 1; }

render() {
  hyprctl binds -j | python3 -c '
import json, sys
from collections import defaultdict

# Derived from the bitmask, never a table of combinations: an enumeration has to
# remember modmask 0, and the script this replaced did not.
BITS = ((64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift"))

def combo(bind):
    key = bind["key"] or ("code:" + str(bind["keycode"]))
    return " + ".join([name for bit, name in BITS if bind["modmask"] & bit] + [key])

groups = defaultdict(list)
for bind in json.load(sys.stdin):
    description = bind.get("description") or ""
    if not description:
        continue
    category, _, action = description.partition(":")
    groups[category if action else "Other"].append((combo(bind), (action or category).strip()))

print("# Keybindings")
print()
print("Generated by `hypr-keybindings-doc` from `hyprctl binds -j`. Do not edit by")
print("hand -- every line here comes from a bind description, so rebinding and")
print("regenerating is the only way to change it.")
print()
print(f"{sum(len(v) for v in groups.values())} bindings.")
for category in sorted(groups):
    print()
    print(f"## {category}")
    print()
    print("| Keys | Action |")
    print("| --- | --- |")
    for keys, action in sorted(groups[category], key=lambda r: r[1]):
        print(f"| `{keys}` | {action} |")
'
}

if [[ ${1-} == --check ]]; then
  if diff -u "$doc" <(render) >/tmp/keybindings-drift.diff 2>&1; then
    echo "docs/keybindings.md is current"
    exit 0
  fi
  echo "docs/keybindings.md is STALE:" >&2
  cat /tmp/keybindings-drift.diff >&2
  exit 1
fi

# Via a temp file: redirecting straight into $doc truncates it before render runs,
# so a failure part-way would leave the doc empty rather than untouched.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
render > "$tmp"
mv "$tmp" "$doc"
trap - EXIT
echo "wrote ${doc#"$repo"/}"
