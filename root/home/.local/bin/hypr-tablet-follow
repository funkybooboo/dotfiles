#!/usr/bin/env python3
"""hypr-tablet-follow -- keep the Wacom pen mapped to the focused monitor.

Hyprland's tablet output (input:tablet:output) is static config: the pen maps
to one fixed monitor, or stretches across all of them when unset. This daemon
watches the Hyprland event socket for focusedmon events and rewrites the
machine-local ~/.config/hypr/tablet.lua so the pen maps to whatever monitor
the mouse is active on. Hyprland's config file-watcher reloads on every
rewrite, so no manual reload is ever needed.

Writes are atomic (temp file + os.replace) -- never rm + cp, which sticks the
watcher (the same trap nwg-displays avoids). Identical content is skipped, so
a focus event that did not cross monitors costs nothing.

Started by autostart.lua (`uwsm app --`, the espanso pattern from 000325) so
the daemon inherits the session env -- the socket path is
$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock -- and dies
with the uwsm scope. See migrations/000586-wacom-tablet.sh.
"""

import json
import os
import socket
import subprocess
import sys
import tempfile

CONFIG_DIR = os.path.expanduser("~/.config/hypr")
TABLET_LUA = os.path.join(CONFIG_DIR, "tablet.lua")
TEMPLATE = (
    "-- machine-local, rewritten by hypr-tablet-follow (000586) -- do not track\n"
    'hl.config({ input = { tablet = { output = "%s" } } })\n'
)
EVENT_PREFIX = "focusedmon>>"


def focused_monitor():
    """Name of the currently focused monitor, via hyprctl."""
    try:
        out = subprocess.run(
            ["hyprctl", "monitors", "-j"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError) as err:
        print(f"hypr-tablet-follow: hyprctl failed: {err}", file=sys.stderr)
        return None
    for mon in json.loads(out):
        if mon.get("focused"):
            return mon["name"]
    return None


def write_tablet(name):
    """Atomically point the pen at `name`; True only on a real change."""
    content = TEMPLATE % name
    try:
        with open(TABLET_LUA) as f:
            if f.read() == content:
                return False
    except FileNotFoundError:
        pass
    fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".tablet.", suffix=".lua")
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.replace(tmp, TABLET_LUA)  # atomic rename -- never rm + cp
    return True


def main():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not sig or not runtime:
        print("hypr-tablet-follow: no Hyprland session env, exiting", file=sys.stderr)
        return 1
    sock_path = os.path.join(runtime, "hypr", sig, ".socket2.sock")

    # Sync once at startup: the login-focused monitor gets the pen even if
    # focus never crosses a monitor boundary afterwards.
    current = focused_monitor()
    if current and write_tablet(current):
        print(f"hypr-tablet-follow: pen -> {current}", file=sys.stderr)

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(sock_path)
            for line in sock.makefile("r"):
                if not line.startswith(EVENT_PREFIX):
                    continue
                # focusedmon>>MONITOR,WORKSPACE
                name = line[len(EVENT_PREFIX):].split(",", 1)[0].strip()
                if not name or name == current:
                    continue
                current = name
                if write_tablet(name):
                    print(f"hypr-tablet-follow: pen -> {name}", file=sys.stderr)
    except OSError as err:
        # Session ended (socket gone) -- exit with the uwsm scope.
        print(f"hypr-tablet-follow: event socket gone ({err}), exiting", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
