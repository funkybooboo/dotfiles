#!/usr/bin/env python3
"""hypr-tablet-follow -- keep the Wacom pen mapped to the focused monitor.

Hyprland's tablet output (input:tablet:output) is static config: the pen maps
to one fixed monitor, or stretches across all of them when unset. This daemon
watches the Hyprland event socket for focusedmon events and applies the
focused monitor AT RUNTIME via

    hyprctl eval 'hl.config({ input = { tablet = { output = "NAME" } } })'

It deliberately does NOT rewrite ~/.config/hypr/tablet.lua. The original
(000586) version did exactly that, leaning on Hyprland's inotify config
watcher to auto-reload -- but a config reload KILLS any active window drag,
so every super+drag across a monitor boundary died the instant focusedmon
fired: one focus crossing, one tablet.lua write, one mid-drag reload, drag
dead at the boundary (verified with a socket trace 2026-11-21: two
configreloaded events per crossing, changefloatingmode ending the drag each
time). The eval path applies the same option with no reload -- verified live
on Hyprland 0.57.1: input:tablet:output changes, no configreloaded event
fires, drags survive monitor crossings.

tablet.lua stays as the login-time default (and a real file so hyprland.lua's
require always resolves); the daemon also re-syncs after every configreloaded
event so a manual `hyprctl reload` cannot leave the pen on the stale
tablet.lua value beyond one event-loop tick.

Started by autostart.lua (`uwsm app --`, the espanso pattern from 000325) so
the daemon inherits the session env -- the socket path is
$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock -- and dies
with the uwsm scope. See migrations/000586-wacom-tablet.sh.
"""

import json
import os
import socket
import subprocess
import sys

EVENT_PREFIX = "focusedmon>>"
RELOADED_PREFIX = "configreloaded>>"


def focused_monitor():
    """Name of the currently focused monitor, via hyprctl."""
    try:
        out = subprocess.run(
            ["hyprctl", "monitors", "-j"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError) as err:
        print(f"hypr-tablet-follow: hyprctl failed: {err}", file=sys.stderr)
        return None
    for mon in json.loads(out):
        if mon.get("focused"):
            return mon["name"]
    return None


def apply_tablet(name):
    """Point the pen at `name` at runtime; True only on a real change."""
    # DRM output names are [A-Z]-[0-9]+; escaping is belt and braces.
    safe = name.replace("\\", "\\\\").replace('"', '\\"')
    code = 'hl.config({ input = { tablet = { output = "%s" } } })' % safe
    try:
        result = subprocess.run(
            ["hyprctl", "eval", code],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as err:
        print(f"hypr-tablet-follow: hyprctl eval failed: {err}", file=sys.stderr)
        return False
    if result != "ok":
        print(f"hypr-tablet-follow: hyprctl eval said: {result}", file=sys.stderr)
        return False
    return True


def main():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not sig or not runtime:
        print("hypr-tablet-follow: no Hyprland session env, exiting", file=sys.stderr)
        return 1
    sock_path = os.path.join(runtime, "hypr", sig, ".socket2.sock")

    # Sync once at startup: the login-focused monitor gets the pen even if
    # focus never crosses a monitor boundary afterwards.
    current = focused_monitor()
    if current and apply_tablet(current):
        print(f"hypr-tablet-follow: pen -> {current}", file=sys.stderr)

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(sock_path)
            for line in sock.makefile("r"):
                if line.startswith(EVENT_PREFIX):
                    # focusedmon>>MONITOR,WORKSPACE
                    name = line[len(EVENT_PREFIX):].split(",", 1)[0].strip()
                    if not name or name == current:
                        continue
                    current = name
                    if apply_tablet(name):
                        print(f"hypr-tablet-follow: pen -> {name}", file=sys.stderr)
                elif line.startswith(RELOADED_PREFIX):
                    # A reload just re-applied tablet.lua's stale value; put
                    # the pen back on the focused monitor. No loop: eval
                    # does not itself reload the config.
                    name = focused_monitor()
                    if name:
                        current = name
                        apply_tablet(name)
    except OSError as err:
        # Session ended (socket gone) -- exit with the uwsm scope.
        print(f"hypr-tablet-follow: event socket gone ({err}), exiting", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
