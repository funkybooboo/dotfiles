#!/bin/bash
# keepawake-toggle -- flip the idle escalation off/on, optionally waking displays.
#
# Kills hypridle to keep the machine awake, restarts it to restore normal timers.
# hypridle is NOT a systemd unit here -- Hyprland starts it via
# `uwsm app -- hypridle` (autostart.conf), so `systemctl --user stop hypridle` is
# a silent no-op and its is-active check reports inactive while the process runs.
#
# --wake additionally cycles dpms to bring dark displays back. The keybind passes
# it because the screens may already have blanked; the bar button does not,
# because clicking a visible icon proves they are awake.

# Blocks until hypridle's presence matches the target, so the script does not
# report success before the transition landed and the bar's next poll reads the
# final state. Measured transitions are ~30ms to die and ~110ms for uwsm to
# register the scope, so the 1s ceiling is a safety net, not the expected wait.
await_hypridle() {
    local target="$1" i
    for ((i = 0; i < 100; i++)); do
        if [[ $target == running ]]; then
            pgrep -x hypridle >/dev/null && return 0
        else
            pgrep -x hypridle >/dev/null || return 0
        fi
        sleep 0.01
    done
    return 1
}

case "${1-}" in
    --wake) hyprctl dispatch dpms off && hyprctl dispatch dpms on ;;
    "")     ;;
    *)      printf 'usage: %s [--wake]\n' "${0##*/}" >&2; exit 2 ;;
esac

if pgrep -x hypridle >/dev/null; then
    pkill -u "$(whoami)" -x hypridle
    await_hypridle gone
    notify-send "Keep awake" "On -- screens stay on" -h string:x-canonical-private-synchronous:keepawake
else
    # Output is discarded because the shell is this script's parent on a bar click:
    # hypridle would otherwise log its whole startup into that stream.
    uwsm app -- hypridle >/dev/null 2>&1 &
    await_hypridle running
    notify-send "Keep awake" "Off -- normal idle timers" -h string:x-canonical-private-synchronous:keepawake
fi
