#!/usr/bin/env bash
# media-keys -- volume/brightness media-key handler for Hyprland binds.
#
# Mirrors the swayosd-client CLI (--output-volume raise|lower|mute-toggle [N],
# --input-volume mute-toggle, --brightness raise|lower [N]) so it can be a
# drop-in replacement in Hyprland binds.
#
# No on-screen display. The state is shown live in the waybar pulseaudio /
# backlight modules (icon + percent), like the battery module -- so there is
# no floating popup. This wrapper just performs the change:
#   - Volume: wpctl (PipeWire) directly. Capped at VOL_MAX (150%, i.e. allows
#     boost above 100). -l limits the raise so it never exceeds VOL_MAX_LINEAR.
#   - Brightness: brightnessctl directly (reliable, clamps to [0, max]).
#     swayosd 0.3.2 gets brightness WRONG on this backlight (raise no-ops /
#     lowers, lower raises) so it is not used at all.
set -u

VOL_DEFAULT_STEP=5         # percent, used when no step given
VOL_MAX=150                # max output volume as a percent (0-150; >100 = boost)
VOL_MAX_LINEAR=1.5         # VOL_MAX as a wpctl linear limit (150%)

# Apply the action directly via wpctl (volume) or brightnessctl (brightness).
# raise/lower take an optional percent step (default VOL_DEFAULT_STEP);
# brightness step is passed through (brightnessctl clamps to [0, max], so a big
# step jumps to the rail).
apply() {
  local kind="$1" verb="$2" step="${3:-}"
  case "$kind" in
    --output-volume)
      case "$verb" in
        raise)        wpctl set-volume -l "$VOL_MAX_LINEAR" @DEFAULT_AUDIO_SINK@ "${step:-$VOL_DEFAULT_STEP}%+" ;;
        lower)        wpctl set-volume         @DEFAULT_AUDIO_SINK@ "${step:-$VOL_DEFAULT_STEP}%-" ;;
        mute-toggle)  wpctl set-mute           @DEFAULT_AUDIO_SINK@ toggle ;;
      esac
      ;;
    --input-volume)
      case "$verb" in
        mute-toggle)  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
      esac
      ;;
    --brightness)
      case "$verb" in
        raise)  brightnessctl set "+${step:-$VOL_DEFAULT_STEP}%" ;;
        lower)  brightnessctl set "${step:-$VOL_DEFAULT_STEP}%-" ;;
      esac
      ;;
  esac
}

# --- main ------------------------------------------------------------------
if (( $# == 0 )); then
  echo "usage: media-keys --output-volume raise|lower|mute-toggle [step]" >&2
  echo "       media-keys --input-volume mute-toggle" >&2
  echo "       media-keys --brightness raise|lower [step]" >&2
  exit 2
fi

apply "$@"
