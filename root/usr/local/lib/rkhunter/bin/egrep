#!/bin/sh
# rkhunter calls bare `egrep` and exposes no EGREP_CMD setting, so Arch's
# warning-emitting /usr/bin/egrep is displaced via PATH rather than configured.
# `grep` resolves to the sibling shim in this dir, so egrep output gets the
# same stray-backslash stderr filter as bare grep calls.
exec grep -E "$@"
